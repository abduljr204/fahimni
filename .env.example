# Copy to .env.local and adjust. Never commit real values.

# "prototype" (default): demo data in the browser, simulated bookings, messages and payments.
# "production": real services only. Demo data is never shown in this mode.
NEXT_PUBLIC_APP_MODE=prototype

# ── Production (Phase 4) ─────────────────────────────────────────────────────
# Public values: safe in the browser because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets: never prefix with NEXT_PUBLIC_, never import from client code.
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER_SECRET_KEY=

# Video classroom. "simulated" (default), or "livekit" or "daily" for real calls.
NEXT_PUBLIC_VIDEO_PROVIDER=simulated
# LiveKit (cloud.livekit.io): server-only, used to sign per-lesson tokens.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Daily (dashboard.daily.co): server-only, used to create rooms and mint per-lesson tokens.
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_URL=https://your-subdomain.daily.co
# Prototype mode only: "true" lets `npm run dev` issue tokens without a real session.
# Production mode always checks the signed-in user in the database.
VIDEO_TEST_MODE=

# Notifications outside the app (production). See docs/ACCOUNTS_AND_TRUST.md.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Fahimni <no-reply@your-domain>"
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=
# Web Push: generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Spam limits in production need a shared store, e.g. Upstash Redis.
RATE_LIMIT_REDIS_URL=
