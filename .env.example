# Copy to .env.local and adjust. Never commit real values.

# "prototype" (default): demo data in the browser, simulated bookings, messages and payments.
# "production": real services only. Demo data is never shown in this mode.
NEXT_PUBLIC_APP_MODE=prototype

# ── Production (Phase 4) ─────────────────────────────────────────────────────
# Public values: safe in the browser because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets: never prefix with NEXT_PUBLIC_, never import from client code.
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER_SECRET_KEY=

# Video classroom (production): an established provider such as LiveKit, Daily or Twilio.
# Used only on the server to mint short-lived, per-lesson access tokens.
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_SECRET=
VIDEO_PROVIDER_URL=

# Notifications outside the app (production). See docs/ACCOUNTS_AND_TRUST.md.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Fahimni <no-reply@your-domain>"
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=
# Web Push: generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Spam limits in production need a shared store, e.g. Upstash Redis.
RATE_LIMIT_REDIS_URL=
